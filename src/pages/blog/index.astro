---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import headerHtml from '../../data/homepage/header.html?raw';
import footerHtml from '../../data/homepage/footer.html?raw';
import pageHtml from '../../data/blog-archive/page-1.html?raw';
import manifest from '../../data/blog-archive/manifest.json';

const page = manifest['1'];

if (!page) {
  throw new Error('Missing blog archive page 1. Run: npm run fetch-blog-archive-all');
}

const DEFAULT_BODY_CLASS =
  'wp-singular page-template page-template-elementor_header_footer page page-id-688 wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-template-full-width elementor-kit-9 elementor-page elementor-page-688';
---

<ContentPageLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  ogImage={page.ogImage}
  bodyClass={page.bodyClass || DEFAULT_BODY_CLASS}
  postCss={page.postCss || ['post-688.css']}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={pageHtml} />
  <Fragment set:html={footerHtml} />
</ContentPageLayout>
