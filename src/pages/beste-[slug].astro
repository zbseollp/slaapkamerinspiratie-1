---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import headerHtml from '../data/homepage/header.html?raw';
import footerHtml from '../data/homepage/footer.html?raw';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { PRODUCT_SLUGS } from '../data/product-slugs';

const productsDir = join(process.cwd(), 'src/content/products');

const PRODUCT_BODY_CLASS =
  'wp-singular page-template page-template-elementor_header_footer page page-id-50 wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-template-full-width elementor-kit-9 elementor-page elementor-page-50';

export async function getStaticPaths() {
  return PRODUCT_SLUGS.map((fullSlug) => ({
    params: { slug: fullSlug.replace(/^beste-/, '') },
    props: { fullSlug },
  }));
}

const { fullSlug } = Astro.props;

const productMeta = JSON.parse(readFileSync(join(productsDir, `${fullSlug}.json`), 'utf8'));
let productHtml = readFileSync(join(productsDir, `${fullSlug}.html`), 'utf8');

productHtml = productHtml.replace(
  /(<div\s+)data-elementor-type="wp-page"/,
  '$1id="content" data-elementor-type="wp-page"'
);
---

<ContentPageLayout
  title={productMeta.title}
  description={productMeta.description}
  canonical={productMeta.canonical || `/${fullSlug}/`}
  bodyClass={productMeta.bodyClass || PRODUCT_BODY_CLASS}
  postCss={productMeta.postCss || ['post-50.css']}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={productHtml} />
  <Fragment set:html={footerHtml} />
</ContentPageLayout>
