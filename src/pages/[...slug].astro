---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import headerHtml from '../data/homepage/header.html?raw';
import footerHtml from '../data/homepage/footer.html?raw';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import manifest from '../data/blog-pages/manifest.json';

const DEFAULT_BODY_CLASS =
  'wp-singular post-template-default single single-post wp-embed-responsive wp-theme-hello-elementor hello-elementor-default elementor-default elementor-kit-9 elementor-page elementor-page-21379';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');

  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { slug: entry.id },
  }));
}

const { slug } = Astro.props;
const page = manifest[slug as keyof typeof manifest];

if (!page) {
  throw new Error(`Missing blog page data for "${slug}". Run: npm run fetch-blog-all`);
}

const pageHtml = readFileSync(join(process.cwd(), 'src/data/blog-pages', `${slug}.html`), 'utf8');
---

<ContentPageLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  ogImage={page.ogImage}
  bodyClass={page.bodyClass || DEFAULT_BODY_CLASS}
  modifiedTime={page.modifiedTime}
  publishedTime={page.publishedTime}
  postCss={page.postCss || ['post-21379.css']}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={pageHtml} />
  <Fragment set:html={footerHtml} />
</ContentPageLayout>
