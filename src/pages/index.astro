---
import HomeLayout from '../layouts/HomeLayout.astro';
import headerHtml from '../data/homepage/header.html?raw';
import mainHtml from '../data/homepage/main.html?raw';
import footerHtml from '../data/homepage/footer.html?raw';
import meta from '../data/homepage/meta.json';

const { title, description, modifiedTime, ogImage, bodyClass } = meta;
---

<HomeLayout
  title={title}
  description={description}
  modifiedTime={modifiedTime}
  ogImage={ogImage}
  bodyClass={bodyClass}
>
  <Fragment set:html={headerHtml} />
  <Fragment set:html={mainHtml} />
  <Fragment set:html={footerHtml} />
</HomeLayout>
