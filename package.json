{
  "name": "slaapkamerinspiratie",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sanitize:blog": "node scripts/sanitize-blog.mjs",
    "assert:publish": "node scripts/assert-publish-ready.mjs",
    "apply:images": "node scripts/apply-payload-images.mjs",
    "inject:archive": "node scripts/inject-payload-archive.mjs",
    "inject:homepage": "node scripts/inject-payload-homepage.mjs",
    "prebuild": "npm run sanitize:blog && npm run assert:publish",
    "dev": "astro dev",
    "build": "node scripts/enrich-homepage-blog.mjs && npm run inject:homepage && node scripts/enrich-blog-pages.mjs && npm run apply:images && node scripts/enrich-blog-archive.mjs && npm run inject:archive && node scripts/enrich-sitemap.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "node scripts/migrate-wordpress.mjs",
    "fetch-homepage": "node scripts/fetch-homepage.mjs",
    "fetch-homepage-css": "node scripts/fetch-homepage-css.mjs",
    "fetch-homepage-all": "node scripts/fetch-homepage-css.mjs && node scripts/fetch-homepage.mjs",
    "fetch-content-css": "node scripts/fetch-content-css.mjs",
    "fetch-inner-pages": "node scripts/fetch-inner-pages.mjs",
    "fetch-content-all": "node scripts/fetch-content-css.mjs && node scripts/fetch-inner-pages.mjs && node scripts/enrich-content-pages.mjs && node scripts/enrich-sitemap.mjs",
    "enrich-sitemap": "node scripts/enrich-sitemap.mjs",
    "enrich-content-pages": "node scripts/enrich-content-pages.mjs",
    "fetch-blog-pages": "node scripts/fetch-blog-pages.mjs",
    "enrich-blog-pages": "node scripts/enrich-blog-pages.mjs",
    "fetch-blog-all": "node scripts/fetch-blog-pages.mjs && node scripts/enrich-blog-pages.mjs",
    "fetch-blog-archive": "node scripts/fetch-blog-archive.mjs",
    "enrich-blog-archive": "node scripts/enrich-blog-archive.mjs",
    "fetch-blog-archive-all": "node scripts/fetch-blog-archive.mjs && node scripts/enrich-blog-archive.mjs",
    "enrich-homepage-blog": "node scripts/enrich-homepage-blog.mjs",
    "scrape-products": "node scripts/scrape-product-pages.mjs",
    "deploy": "npm run build && node scripts/guard-deploy.mjs && npx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "astro": "^5.7.10"
  },
  "devDependencies": {
    "fast-xml-parser": "^4.5.1",
    "linkedom": "^0.18.12",
    "typescript": "^5.7.3",
    "wrangler": "^4.105.0"
  }
}
